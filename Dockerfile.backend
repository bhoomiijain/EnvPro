# syntax=docker/dockerfile:1

# Stage 1: Build the backend with Maven and Java 25
FROM maven:3.9.11-eclipse-temurin-25-alpine AS backend-build
WORKDIR /app

# Copy the entire project
COPY . .

# Build the backend
RUN mvn clean package -q -DskipTests -f server/pom.xml

# Stage 2: Runtime backend container with Java 25
FROM eclipse-temurin:25-jre-alpine
WORKDIR /app

# Copy the built JAR from the build stage
COPY --from=backend-build /app/server/target/envpro-server-*.jar app.jar

# Expose the API port
EXPOSE 8888

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8888/actuator/health || exit 1

# Run the Spring Boot application
ENTRYPOINT ["java", "-jar", "app.jar"]
CMD []
